# ── AI Configuration ───────────────────────────────────────────────────
# Required: API key from Groq Cloud (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── External APIs ───────────────────────────────────────────────────────
# Optional: SerpApi key for live web searches (https://serpapi.com)
SERPAPI_API_KEY=your_serpapi_key_here

# ── Firebase & Firestore ────────────────────────────────────────────────
# Path to your Firebase Admin SDK service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# Alternatively, you can supply inline credentials instead of the file path:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Application Settings ────────────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Directory paths for persistence and media storage
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
VIDEOS_DIR=./videos
MAX_UPLOAD_SIZE_MB=10
MANIM_TIMEOUT=120
